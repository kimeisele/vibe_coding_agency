    "---",
    "\n",
    "## Abschnitt 1: Konfiguration\n",
    "\n",
    "Tragen Sie hier alle projektspezifischen Informationen ein. Dies ist der einzige Ort, an dem Sie manuelle Eingaben machen müssen, bevor der Prozess startet."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "PROJECT_NAME = \"Beispiel-Projekt: React Timeline Schätzung\"\n",
    "CLIENT_REQUEST = \"Ein Kunde hat eine React-App, will neue Features und ich muss eine Timeline schätzen.\"\n",
    "\n",
    "# Dieser Pfad wird später für die Code-Analyse in Phase 3 benötigt\n",
    "PATH_TO_CLIENT_CODE = \"/pfad/zum/code/des/kunden\" # WICHTIG: Passen Sie diesen Pfad an, bevor Sie Phase 3 ausführen\n",
    "\n",
    "# Simulierte Antwort vom Kunden nach Phase 1\n",
    "SIMULATED_CLIENT_RESPONSE = {\n",
    "    \"feature_request\": \"Wir brauchen eine Standard-User-Authentication mit E-Mail/Passwort und Google-Login.\",\n",
    "    \"tech_stack\": \"Create-React-App, React 17, Jest\"\n",
    "}\n",
    "\n",
    "print(f\"Projekt '{PROJECT_NAME}' konfiguriert.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---",
    "\n",
    "## Abschnitt 2: Hilfsfunktionen\n",
    "\n",
    "Hier definieren wir unsere \"Runner\" oder \"Core-Logik\". Diese Funktionen kapseln die Komplexität und sorgen dafür, dass die späteren Workflow-Zellen sauber und lesbar bleiben. Dies verhindert, dass das Notebook zu einem Monolithen wird."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess\n",
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "from typing import List, Dict, Any\n",
    "\n",
    "def run_web_search(query: str, num_results: int = 3) -> List[Dict[str, str]]:\n",
    "    \"\"\"Führt eine Web-Suche durch und extrahiert Titel, Link und Snippet.\"\"\"\n",
    "    print(f\"\\n🔍 Führe Web-Suche durch für: '{query}'...\")\n",
    "    try:\n",
    "        # Dies ist eine Simulation. In einer echten Umgebung würde hier ein API-Call stehen.\n",
    "        # z.B. mit der Google Search API oder über einen Dienst wie SerpAPI.\n",
    "        # Für diese Demo simulieren wir eine Suche nach React-Auth-Bibliotheken.\n",
    "        if \"authentication\" in query.lower():\n",
    "            return [\n",
    "                {\"title\": \"Auth0 React SDK Quickstarts\", \"link\": \"https://auth0.com/docs/quickstart/spa/react\", \"snippet\": \"Auth0 provides a managed authentication service...\"},\n",
    "                {\"title\": \"Firebase Authentication for Web with React\", \"link\": \"https://firebase.google.com/docs/auth/web/react\", \"snippet\": \"Get started with Firebase Authentication in your React app...\"},\n",
    "                {\"title\": \"Supabase Auth with React\", \"link\": \"https://supabase.com/docs/guides/auth/auth-helpers/react\", \"snippet\": \"Supabase is an open source Firebase alternative...\"}\n",
    "            ]\n",
    "        return []\n",
    "    except Exception as e:\n",
    "        print(f\"\\t❌ Fehler bei der Web-Suche: {e}\")\n",
    "        return []\n",
    "\n",
    "def run_code_scan(code_path: str, tech: str) -> Dict[str, Any]:\n",
    "    \"\"\"Führt eine Suite von Analyse-Tools auf einer Codebasis aus.\"\"\"    print(f\"\\n🔬 Führe Code-Scan durch für Technologie '{tech}' im Pfad '{code_path}'...\")\n",
    "    \n",
    "    TECH_STACK_TOOLS = {\n",
    "        \"react\": {\n",
    "            \"linter\": \"npx eslint .\",\n",
    "            \"dependencies\": \"npm outdated\",\n",
    "            \"test_coverage\": \"npm test -- --coverage --watchAll=false\"\n",
    "        }\n",
    "    }\n",
    "    \n",
    "    tools = TECH_STACK_TOOLS.get(tech.lower())\n",
    "    if not tools:\n",
    "        print(f\"\\t❌ Keine Tools für '{tech}' konfiguriert.\")\n",
    "        return {}\n",
    "    \n",
    "    results = {}\n",
    "    for tool_name, command in tools.items():\n",
    "        print(f\"\\t🔧 Führe Tool aus: {tool_name} ({command})\")\n",
    "        try:\n",
    "            # WICHTIG: Dieser Befehl wird auf Ihrem System ausgeführt!\n",
    "            # In einem echten Szenario würde dies in einer sicheren, isolierten Umgebung (z.B. Docker) geschehen.\n",
    "            result = subprocess.run(\n",
    "                command, shell=True, cwd=code_path, capture_output=True, text=True, timeout=120\n",
    "            )\n",
    "            results[tool_name] = {\"output\": result.stdout + result.stderr, \"exit_code\": result.returncode}\n",
    "            print(f\"\\t\\t... abgeschlossen mit Exit-Code {result.returncode}.\")\n",
    "        except FileNotFoundError:\n",
    "             # This happens if the client code path is not valid\n",
    "             error_msg = f\"Pfad '{code_path}' nicht gefunden. Bitte passen Sie die Variable 'PATH_TO_CLIENT_CODE' in Abschnitt 1 an.\"\n",
    "             results[tool_name] = {\"error\": error_msg}\n",
    "             print(f\"\\t\\t❌ {error_msg}\")\n",
    "        except Exception as e:\n",
    "            results[tool_name] = {\"error\": str(e)}\n",
    "            print(f\"\\t\\t❌ Fehler bei der Ausführung: {e}\")\n",
    "            \n",
    "    return results\n",
    "\n",
    "print(\"Hilfsfunktionen sind definiert und bereit.\")"
   ]
  },
